{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./*"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "client/**/*.ts",
    "client/**/*.tsx",
    "scripts/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}